# Port d'écoute
PORT=3000
# Dossier des données (base SQLite + fichiers déposés). À SAUVEGARDER.
DATA_DIR=./data
# Adresse publique du logiciel (sert à fabriquer les liens envoyés aux clients)
PUBLIC_URL=https://os.example.fr
# 1 = cookies uniquement en HTTPS (à mettre en production)
COOKIE_SECURE=1
# Secret des sessions (facultatif : sinon généré et gardé dans la base)
SESSION_SECRET=
# Envoi des codes de vérification aux clients (facultatif en mode test)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Carchon Les Ateliers <atelier@example.fr>"

# E-mails aux clients (codes de validation des devis) : un compte Gmail + un mot de passe d'application Google
GMAIL_USER=
GMAIL_APP_PASSWORD=
# SMS de suivi aux clients (Brevo, brevo.com) : clé API
BREVO_API_KEY=
# Adresse d'expédition des e-mails si on passe par Brevo (validée dans Brevo › Expéditeurs)
MAIL_FROM=

# Qonto (facture d'acompte automatique) : Paramètres › Intégrations et partenariats › Clé API
QONTO_LOGIN=
QONTO_SECRET_KEY=
